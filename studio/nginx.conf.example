# AI-Photoshop — что нужно nginx.
#
# Папку можно назвать как угодно (ai-photoshop, editor, …) и переименовывать когда угодно:
# все пути внутри неё относительные, а правила ниже не привязаны к имени папки.
# Приложение целиком берётся из этой папки: интернет и сторонние сайты не нужны.
#
# Вставьте эти блоки внутрь вашего server { ... }. Если раньше вы добавляли блок
# location /photocraft/ { ... } — удалите его, он больше не нужен.
#
# Обычной раздачи статики (включая include mime.types; в блоке http — он есть в стандартном
# nginx.conf) достаточно, чтобы редактор открылся. Настройки ниже нужны помощнику и «Моим файлам».

# 1. ОБЯЗАТЕЛЬНО для помощника: он отправляет снимок экрана (больше стандартного 1 МБ),
#    а модель думает дольше стандартных 60 секунд.
location ~ /api/assistant\.php$ {
    client_max_body_size 20m;
    fastcgi_read_timeout 200s;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_pass php:9000;   # ← как в вашем общем блоке PHP
}

# 2. «Мои файлы» (файлы пользователей на сервере): сохранение больших PSD.
#    Если такой блок уже есть для другого приложения (AI-Figma, AI-Word…) — второй не нужен,
#    но client_max_body_size в нём должен быть не меньше 1g.
location ~ /api/files\.php$ {
    client_max_body_size 1g;
    fastcgi_read_timeout 300s;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_pass php:9000;   # ← как в вашем общем блоке PHP
}

# 3. Внутренние файлы помощника не нужны снаружи.
location ~ /api/(settings|tools)\.php$ {
    deny all;
}

# 4. Где лежат файлы пользователей. По умолчанию — /app/storage/ai-photoshop (рядом с корнем сайта,
#    снаружи его не видно; папка создаётся сама). Если PHP не может туда писать, файлы ложатся в
#    ai-photoshop-data рядом с папкой приложения — тогда закройте её (имена файлов там случайные, но лучше закрыть):
location ~ /ai-photoshop-data/ {
    deny all;
}
